# Secret used to sign jurisdiction-gate JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# At minimum 32 bytes of entropy. Rotate periodically.
GATE_TOKEN_SECRET=replace-with-a-long-random-secret

# Token TTL in seconds (default 600 = 10 minutes per spec section 3.2)
GATE_TOKEN_TTL_SECONDS=600
